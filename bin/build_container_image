#!/bin/bash

REGISTRY=${REGISTRY:-"docker.io"}
ORGANIZATION=${ORGANIZATION:-"manageiq"}
IMAGE_NAME=$REGISTRY/$ORGANIZATION/httpd

set -e

docker build . -t localhost/build:latest

VERSION=$(docker run --rm --entrypoint bash localhost/build:latest -c "rpm -q --queryformat '%{VERSION}\n' httpd")
IFS=. read major minor _patch <<< ${VERSION}

os_major=$(docker run --rm --entrypoint bash localhost/build:latest -c "/usr/libexec/platform-python -c 'import dnf; print(dnf.dnf.Base().conf.substitutions[\"releasever_major\"])'")

set -v
docker tag localhost/build:latest $IMAGE_NAME:$major-el$os_major
docker tag localhost/build:latest $IMAGE_NAME:$major.$minor-el$os_major
set +v

docker images

[ -z "$REGISTRY_USERNAME" ] && exit 0

echo "$REGISTRY_PASSWORD" | docker login $REGISTRY -u $REGISTRY_USERNAME --password-stdin

docker push $IMAGE_NAME:$major-el$os_major
docker push $IMAGE_NAME:$major.$minor-el$os_major

set +e
